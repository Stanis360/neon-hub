<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NeonMonitor – Hardware-Überwachung für Windows (WPF).
    Ziel: .NET 10 (aktuelles LTS). Auf Windows wird das .NET 10 SDK benötigt.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NeonMonitor</RootNamespace>
    <AssemblyName>NeonMonitor</AssemblyName>
    <Version>0.3.0</Version>
    <!-- Sensorzugriff (PawnIO-Treiber, MSRs) braucht Adminrechte → siehe app.manifest -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Programmsymbol (Taskleiste, Desktop-Verknüpfung) -->
    <ApplicationIcon>Assets\NeonMonitor.ico</ApplicationIcon>
    <!-- Nur 64-Bit: LibreHardwareMonitor und die PDH-Strukturen sind auf x64 ausgelegt -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Erlaubt das Kompilieren auch außerhalb von Windows (z. B. CI) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sensoren: CPU, GPU, RAM (nutzt PawnIO-Treiber + AMD ADL aus dem Grafiktreiber) -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!--
    PresentMon (Intel, MIT-Lizenz) für die FPS-Messung per ETW – ohne Injection ins Spiel.
    Wird beim ersten Build automatisch von GitHub geladen, per SHA-256 geprüft und als
    Tools\PresentMon.exe neben NeonMonitor.exe abgelegt.
    Update: Version + Prüfsumme hier anpassen.
  -->
  <PropertyGroup>
    <PresentMonVersion>2.6.0</PresentMonVersion>
    <PresentMonSha256>B2A706BC6AD475749E3B7E3409263AA1E6906D45BDCF993F6DBC0F660188F1AF</PresentMonSha256>
    <PresentMonUrl>https://github.com/GameTechDev/PresentMon/releases/download/v$(PresentMonVersion)/PresentMon-$(PresentMonVersion)-x64.exe</PresentMonUrl>
    <PresentMonCacheDir>$(MSBuildProjectDirectory)\obj\tools\</PresentMonCacheDir>
    <PresentMonFile>$(PresentMonCacheDir)PresentMon-$(PresentMonVersion)-x64.exe</PresentMonFile>
  </PropertyGroup>

  <Target Name="DownloadPresentMon" BeforeTargets="BeforeBuild" Condition="!Exists('$(PresentMonFile)')">
    <Message Importance="high" Text="Lade PresentMon $(PresentMonVersion) …" />
    <DownloadFile SourceUrl="$(PresentMonUrl)" DestinationFolder="$(PresentMonCacheDir)"
                  DestinationFileName="PresentMon-$(PresentMonVersion)-x64.exe" Retries="3" ContinueOnError="true" />
    <Warning Condition="!Exists('$(PresentMonFile)')"
             Text="PresentMon konnte nicht geladen werden (keine Internetverbindung?). NeonMonitor läuft, aber ohne FPS." />
    <GetFileHash Condition="Exists('$(PresentMonFile)')" Files="$(PresentMonFile)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_PresentMonHash" />
    </GetFileHash>
    <Delete Condition="Exists('$(PresentMonFile)') And '$(_PresentMonHash)' != '$(PresentMonSha256)'" Files="$(PresentMonFile)" />
    <Error Condition="'$(_PresentMonHash)' != '' And '$(_PresentMonHash)' != '$(PresentMonSha256)'"
           Text="PresentMon: Prüfsumme stimmt nicht ($(_PresentMonHash)) – Datei wurde verworfen." />
  </Target>

  <ItemGroup>
    <None Include="$(PresentMonFile)" Link="Tools\PresentMon.exe" Visible="false"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

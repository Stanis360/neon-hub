<!--
  DataTemplates: wie ViewModels automatisch dargestellt werden.
  Eine ContentControl mit Content="{Binding GpuPower}" zeigt so eine fertige Messwert-Zeile.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:NeonMonitor.ViewModels">

    <!-- Messwert-Zeile: Beschriftung links, Wert rechts, darunter ein schmaler Balken -->
    <DataTemplate DataType="{x:Type vm:MetricViewModel}">
        <Grid x:Name="Root" Margin="0,4,0,6" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ToolTip>
                <TextBlock Text="{Binding PeakText, StringFormat='Höchstwert seit Start: {0}'}" />
            </Grid.ToolTip>
            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                       Foreground="{StaticResource TextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Höchstwert (nur bei Temperaturen eingeblendet) -->
                <TextBlock x:Name="Peak" Text="{Binding PeakText}" Visibility="Collapsed" Margin="0,0,10,0"
                           FontFamily="{StaticResource DisplayFont}" FontSize="12" VerticalAlignment="Bottom"
                           Foreground="{StaticResource TextDimBrush}" />
                <TextBlock x:Name="Value" Text="{Binding DisplayWithUnit}"
                           FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
            </StackPanel>
            <ProgressBar x:Name="Bar" Grid.Row="1" Style="{StaticResource Bar}" Margin="0,5,0,0"
                         Maximum="{Binding BarMaximum}" Value="{Binding BarValue, Mode=OneWay}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ShowPeak}" Value="True">
                <Setter TargetName="Peak" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource WarnBrush}" />
                <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource WarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource CriticalBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource TextDimBrush}" />
                <Setter TargetName="Root" Property="ToolTip" Value="Sensor liefert keinen Wert (siehe Sensorbericht)" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Große Kennzahl (FPS-Seite): Beschriftung, großer Wert, Einheit, Höchstwert -->
    <DataTemplate x:Key="StatBlock" DataType="{x:Type vm:MetricViewModel}">
        <Border Background="#1AFFFFFF" CornerRadius="10" Padding="16,10" Margin="5">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock x:Name="Value" Text="{Binding DisplayValue}" Style="{StaticResource BigValue}" />
                    <TextBlock Text="{Binding Unit}" Style="{StaticResource SmallText}" FontSize="14"
                               Margin="5,0,0,8" VerticalAlignment="Bottom" />
                </StackPanel>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource WarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource CriticalBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource TextDimBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Auswahlknopf für die FPS-Anwendung („Automatisch“, „cod.exe“ …) -->
    <DataTemplate DataType="{x:Type vm:FpsChoiceViewModel}">
        <Button x:Name="Btn" Style="{StaticResource FlatButton}" Margin="0,0,8,8" Padding="14,6"
                Content="{Binding Title}" Command="{Binding SelectCommand}" CommandParameter="{Binding Application}" />
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Btn" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Btn" Property="Foreground" Value="#15181A" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Kerntakt: „#1  ▬▬▬▬  5225 MHz“ -->
    <DataTemplate DataType="{x:Type vm:CoreClockViewModel}">
        <Grid Margin="0,2,10,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="66" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Height="4" VerticalAlignment="Center"
                         Maximum="{Binding Maximum}" Value="{Binding Mhz, Mode=OneWay}" />
            <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource SmallText}"
                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <!-- Laufwerkszeile: Name, Füllstandsbalken, Größe -->
    <DataTemplate DataType="{x:Type vm:DriveViewModel}">
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="13" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Margin="0,5,0,3" Maximum="100"
                             Value="{Binding Percent, Mode=OneWay}" />
                <TextBlock Text="{Binding SizeText}" Style="{StaticResource SmallText}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource CriticalBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>

<!--
  Neon-Theme für NeonMonitor.
  Farben, Schriften und Stile für alle Steuerelemente an einem Ort.
  Grundfarbe ist Neongrün (#39FF14) auf fast schwarzem Grund.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Farben ===================== -->
    <Color x:Key="NeonGreenColor">#39FF14</Color>
    <Color x:Key="NeonMintColor">#00FFA3</Color>
    <Color x:Key="NeonCyanColor">#00E5FF</Color>
    <Color x:Key="NeonAmberColor">#FFD23F</Color>
    <Color x:Key="NeonRedColor">#FF3B5C</Color>
    <Color x:Key="BackgroundColor">#020604</Color>
    <Color x:Key="TextColor">#D8FFE0</Color>
    <Color x:Key="TextDimColor">#6FA77E</Color>

    <SolidColorBrush x:Key="NeonGreenBrush" Color="{StaticResource NeonGreenColor}" />
    <SolidColorBrush x:Key="NeonMintBrush" Color="{StaticResource NeonMintColor}" />
    <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyanColor}" />
    <SolidColorBrush x:Key="NeonAmberBrush" Color="{StaticResource NeonAmberColor}" />
    <SolidColorBrush x:Key="NeonRedBrush" Color="{StaticResource NeonRedColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />

    <!-- Halbtransparente Flächen, damit die Hintergrundanimation durchscheint -->
    <SolidColorBrush x:Key="PanelBrush" Color="#C8061009" />
    <SolidColorBrush x:Key="TileBrush" Color="#9A0A1A10" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#5539FF14" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#2639FF14" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1A39FF14" />
    <SolidColorBrush x:Key="PressedBrush" Color="#3339FF14" />

    <!-- ===================== Schriften ===================== -->
    <!-- Bahnschrift ist bei Windows 10/11 dabei und wirkt schön „technisch“ -->
    <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===================== Leuchteffekte ===================== -->
    <DropShadowEffect x:Key="GlowStrong" Color="{StaticResource NeonGreenColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.85" />
    <DropShadowEffect x:Key="GlowValue" Color="{StaticResource NeonGreenColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.75" />
    <DropShadowEffect x:Key="GlowAmber" Color="{StaticResource NeonAmberColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="GlowRed" Color="{StaticResource NeonRedColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
    <DropShadowEffect x:Key="GlowSoft" Color="{StaticResource NeonGreenColor}" BlurRadius="22" ShadowDepth="0" Opacity="0.22" />

    <!-- ===================== Text ===================== -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="Effect" Value="{StaticResource GlowStrong}" />
    </Style>

    <Style x:Key="CardSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TileLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <Style x:Key="TileValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
    </Style>

    <Style x:Key="TileUnit" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="4,0,0,5" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <Style x:Key="SmallText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <!-- ===================== Karten & Kacheln ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Margin" Value="6" />
    </Style>

    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TileBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <!-- ===================== Buttons ===================== -->
    <Style x:Key="NeonButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fensterknöpfe (Minimieren/Maximieren/Schließen) in der eigenen Titelleiste -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CCE81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Schalter (CheckBox als Toggle) ===================== -->
    <Style x:Key="NeonSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="32" Height="16" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{StaticResource PanelBorderBrush}" Background="#33000000">
                            <Ellipse x:Name="Knob" Width="10" Height="10" Margin="3,0" HorizontalAlignment="Left"
                                     Fill="{StaticResource TextDimBrush}" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource NeonGreenBrush}" />
                            <Setter TargetName="Knob" Property="Effect" Value="{StaticResource GlowStrong}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource NeonGreenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Fortschrittsbalken ===================== -->
    <Style x:Key="NeonBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="4" Background="#22000000"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                Background="{TemplateBinding Foreground}">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource NeonGreenColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.7" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Navigation (TabControl links) ===================== -->
    <Style x:Key="NavTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#B0020604" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
                            <StackPanel IsItemsHost="True" Margin="0,14,0,0" />
                        </Border>
                        <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="10" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Background="Transparent" Height="44">
                        <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" Background="{StaticResource NeonGreenBrush}"
                                Visibility="Hidden" Effect="{StaticResource GlowStrong}" />
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="22,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Scrollbar (schmal, neon) ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Background="#5539FF14" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NeonGreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,4">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="4,1">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Tooltip ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#F0050C07" />
        <Setter Property="BorderBrush" Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

</ResourceDictionary>

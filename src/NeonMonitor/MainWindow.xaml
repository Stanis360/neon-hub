<Window x:Class="NeonMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NeonMonitor.Controls"
        xmlns:views="clr-namespace:NeonMonitor.Views"
        xmlns:vm="clr-namespace:NeonMonitor.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="NeonMonitor"
        Width="1320" Height="860" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}">

    <!-- Eigene Titelleiste statt der Windows-Standardleiste -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
        <Grid>
            <!-- Animierter Hintergrund liegt hinter allem -->
            <controls:AnimatedBackground x:Name="BackgroundLayer" IsAnimated="{Binding BackgroundAnimation}"
                                         Mode="{Binding Settings.ActiveEffect}" />

            <DockPanel>
                <!-- ============ Titelleiste ============ -->
                <Grid DockPanel.Dock="Top" Height="42" Background="{StaticResource ChromeBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,10,0" />
                        <TextBlock Text="NeonMonitor" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding Update.VersionShort, Mode=OneWay}" Style="{StaticResource SmallText}" Margin="12,3,0,0" VerticalAlignment="Center" />
                        <TextBlock Margin="20,1,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                   Foreground="{StaticResource CriticalBrush}"
                                   Visibility="{Binding Recording.IsRecording, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="● REC" />
                            <Run Text="{Binding Recording.ElapsedText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="Minimieren" Click="OnMinimize" />
                        <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" ToolTip="Maximieren" Click="OnMaximize" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Schließen" Click="OnClose" />
                    </StackPanel>
                </Grid>

                <!-- ============ Statusleiste ============ -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0" Padding="14,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox Style="{StaticResource Switch}" Content="Animation" VerticalAlignment="Center"
                                      IsChecked="{Binding BackgroundAnimation}" Margin="0,0,16,0"
                                      ToolTip="Hintergrundanimation ein/aus (aus = minimale Last)" />
                            <Button Style="{StaticResource FlatButton}" Content="{Binding IntervalText}" Margin="0,0,8,0"
                                    Command="{Binding CycleIntervalCommand}" ToolTip="Abfrageintervall: 0,5 / 1 / 2 Sekunden" />
                            <Button Style="{StaticResource FlatButton}" Content="Max-Werte zurücksetzen" Margin="0,0,8,0"
                                    Command="{Binding ResetPeaksCommand}" />
                            <Button Style="{StaticResource FlatButton}" Content="Sensorbericht" Margin="0,0,8,0"
                                    Command="{Binding CreateReportCommand}"
                                    ToolTip="Alle Rohsensoren in eine Textdatei schreiben (zur Prüfung der Hardware-Unterstützung)" />
                            <Button Style="{StaticResource FlatButton}" Content="Datenordner"
                                    Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInitializing}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding SensorStatus}" Style="{StaticResource SmallText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ============ Update-Hinweis ============ -->
                <Border DockPanel.Dock="Top" Background="{StaticResource AccentBackBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1"
                        Padding="18,8" Visibility="{Binding Update.IsAvailable, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Jetzt aktualisieren" Command="{Binding Update.InstallCommand}" Margin="0,0,8,0" Padding="14,5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Content="Was ist neu?" Command="{Binding Update.OpenReleasesCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource FlatButton}" Content="Später" Command="{Binding Update.LaterCommand}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="{StaticResource TextBrush}">
                            <Run Text="⬆" Foreground="{StaticResource AccentBrush}" />
                            <Run Text="{Binding Update.BannerText, Mode=OneWay}" />
                            <Run Text="{Binding Update.Status, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- ============ Navigation + Inhalt ============ -->
                <TabControl Style="{StaticResource NavTabControl}">
                    <TabItem Header="▣  Live">
                        <views:LiveView />
                    </TabItem>
                    <TabItem Header="◈  FPS">
                        <views:FpsView DataContext="{Binding Fps}" />
                    </TabItem>
                    <TabItem Header="❄  Kühlung">
                        <views:CoolingView DataContext="{Binding Cooling}" />
                    </TabItem>
                    <TabItem Header="◧  Overlay">
                        <views:OverlayView DataContext="{Binding Overlay}" />
                    </TabItem>
                    <TabItem Header="●  Aufzeichnung">
                        <views:RecordingView DataContext="{Binding Recording}" />
                    </TabItem>
                    <TabItem Header="⇄  Vergleich">
                        <views:CompareView DataContext="{Binding Compare}" />
                    </TabItem>
                    <TabItem Header="▦  Deck">
                        <views:DeckView DataContext="{Binding Deck}" />
                    </TabItem>
                    <TabItem Header="▤  Statistik">
                        <views:StatsView DataContext="{Binding Stats}" />
                    </TabItem>
                    <TabItem Header="⚙  Einstellungen">
                        <views:SettingsView DataContext="{Binding Settings}" />
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </Border>
</Window>

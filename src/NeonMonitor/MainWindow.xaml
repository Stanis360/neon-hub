<Window x:Class="NeonMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NeonMonitor.Controls"
        xmlns:views="clr-namespace:NeonMonitor.Views"
        xmlns:vm="clr-namespace:NeonMonitor.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="NeonMonitor"
        Width="1320" Height="860" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}">

    <!-- Eigene Titelleiste statt der Windows-Standardleiste -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
        <Grid>
            <!-- Animierter Hintergrund liegt hinter allem -->
            <controls:NeonBackground x:Name="BackgroundLayer" IsAnimated="{Binding BackgroundAnimation}" />

            <DockPanel>
                <!-- ============ Titelleiste ============ -->
                <Grid DockPanel.Dock="Top" Height="42" Background="#99020604">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="NEON" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource NeonGreenBrush}" Effect="{StaticResource GlowStrong}" />
                        <TextBlock Text="//MONITOR" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                                   Foreground="{StaticResource TextBrush}" Margin="2,0,0,0" />
                        <TextBlock Text="v0.1 · Schritt 1" Style="{StaticResource SmallText}" Margin="14,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="Minimieren" Click="OnMinimize" />
                        <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" ToolTip="Maximieren" Click="OnMaximize" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Schließen" Click="OnClose" />
                    </StackPanel>
                </Grid>

                <!-- ============ Statusleiste ============ -->
                <Border DockPanel.Dock="Bottom" Background="#D0020604" BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,1,0,0" Padding="14,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox Style="{StaticResource NeonSwitch}" Content="Animation" VerticalAlignment="Center"
                                      IsChecked="{Binding BackgroundAnimation}" Margin="0,0,16,0"
                                      ToolTip="Hintergrundanimation ein/aus (aus = minimale Last)" />
                            <Button Style="{StaticResource NeonButton}" Content="{Binding IntervalText}" Margin="0,0,8,0"
                                    Command="{Binding CycleIntervalCommand}" ToolTip="Abfrageintervall: 0,5 / 1 / 2 Sekunden" />
                            <Button Style="{StaticResource NeonButton}" Content="Max-Werte zurücksetzen" Margin="0,0,8,0"
                                    Command="{Binding ResetPeaksCommand}" />
                            <Button Style="{StaticResource NeonButton}" Content="Sensorbericht" Margin="0,0,8,0"
                                    Command="{Binding CreateReportCommand}"
                                    ToolTip="Alle Rohsensoren in eine Textdatei schreiben (zur Prüfung der Hardware-Unterstützung)" />
                            <Button Style="{StaticResource NeonButton}" Content="Datenordner"
                                    Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource NeonGreenBrush}" />
                                        <Setter Property="Effect" Value="{StaticResource GlowStrong}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInitializing}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource NeonAmberBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding SensorStatus}" Style="{StaticResource SmallText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ============ Navigation + Inhalt ============ -->
                <TabControl Style="{StaticResource NavTabControl}">
                    <TabItem Header="▣  Live">
                        <views:LiveView />
                    </TabItem>
                    <TabItem Header="◈  FPS">
                        <views:PlaceholderView Title="FPS &amp; Frametimes" Step="Schritt 2"
                                               Description="FPS und Frametimes per ETW (PresentMon-Ansatz) – ganz ohne Injection ins Spiel." />
                    </TabItem>
                    <TabItem Header="◧  Overlay">
                        <views:PlaceholderView Title="Overlay" Step="Schritt 3"
                                               Description="Kleines, transparentes Always-on-top-Fenster mit frei wählbaren Werten." />
                    </TabItem>
                    <TabItem Header="●  Aufzeichnung">
                        <views:PlaceholderView Title="Aufzeichnung" Step="Schritt 4"
                                               Description="Start/Stopp per Knopf oder Hotkey, CSV pro Sitzung mit Spielname, Datum und Uhrzeit." />
                    </TabItem>
                    <TabItem Header="⇄  Vergleich">
                        <views:PlaceholderView Title="Vergleich" Step="Schritt 5"
                                               Description="Sitzungen nebeneinander: Ø FPS, 1 % Lows, Höchsttemperaturen, Diagramme." />
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </Border>
</Window>

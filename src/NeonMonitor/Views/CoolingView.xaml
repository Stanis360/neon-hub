<UserControl x:Class="NeonMonitor.Views.CoolingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NeonMonitor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CoolingViewModel}"
             d:DesignWidth="1100" d:DesignHeight="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- Hinweis, falls keine Mainboard-Sensoren da sind -->
            <Border Visibility="{Binding HasBoard, Converter={StaticResource InverseBoolToVisibility}}"
                    Background="#2AE8B44C" CornerRadius="10" Padding="14,10" Margin="6">
                <TextBlock Text="{Binding NoBoardHint}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- ============ Lüfter ============ -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Lüfter" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource SmallText}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,10" TextWrapping="Wrap"
                                   Text="Namen lassen sich direkt ändern. Mit „CPU“ / „Gehäuse“ legst du fest, welcher Anschluss in Overlay und Aufnahme als CPU- bzw. Gehäuselüfter zählt." />
                        <ItemsControl ItemsSource="{Binding Fans}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FanViewModel}">
                                    <Grid x:Name="Row" Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBox Text="{Binding Name}" Padding="4,2" Background="Transparent" BorderBrush="Transparent"
                                                     ToolTip="Klicken zum Umbenennen (z. B. „Gehäuselüfter (4×)“)" />
                                            <TextBlock Style="{StaticResource SmallText}" Margin="5,0,0,0">
                                                <Run Text="{Binding DefaultName, Mode=OneWay}" />
                                                <Run Text="{Binding RoleText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding RpmText}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                                            <ProgressBar Style="{StaticResource Bar}" Margin="0,4,0,0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="CpuBtn" Style="{StaticResource FlatButton}" Content="CPU" Margin="0,0,6,0" Command="{Binding SetCpuCommand}" />
                                            <Button x:Name="CaseBtn" Style="{StaticResource FlatButton}" Content="Gehäuse" Command="{Binding SetCaseCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCpu}" Value="True">
                                            <Setter TargetName="CpuBtn" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="CpuBtn" Property="Foreground" Value="#15181A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCase}" Value="True">
                                            <Setter TargetName="CaseBtn" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="CaseBtn" Property="Foreground" Value="#15181A" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ Temperaturen ============ -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Temperaturen" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Mainboard, SSDs und RAM-Module" Style="{StaticResource SmallText}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,2,0,10" />
                        <ItemsControl ItemsSource="{Binding Temps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TempItemViewModel}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Group}" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Height="4" Margin="0,3,0,0" Maximum="1"
                                                         Value="{Binding Fraction, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock x:Name="Value" Grid.Column="2" Text="{Binding ValueText}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHot}" Value="True">
                                            <Setter TargetName="Value" Property="Foreground" Value="{StaticResource WarnBrush}" />
                                            <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Lüftersteuerung ============ -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasBoard, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Lüftersteuerung durch NeonMonitor"
                                  IsChecked="{Binding ControlEnabled}" VerticalAlignment="Center" />
                        <TextBlock Text="Lüftersteuerung" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SmallText}" FontSize="12" Margin="0,6,0,12"
                               Text="Aus = das Mainboard (BIOS) regelt wie bisher. An = pro Anschluss wählbar: BIOS, feste Leistung oder Lüfterkurve. Sicherheitsnetz: nie unter 20 %, Vollgas ab 90 °C CPU bzw. 105 °C GPU-Hotspot oder wenn ein Temperaturwert fehlt; beim Beenden übernimmt wieder das Mainboard. Gehäuselüfter am besten nach „CPU oder GPU (höherer Wert)“ regeln – die Grafikkarte heizt das Gehäuse beim Spielen am meisten." />

                    <ItemsControl ItemsSource="{Binding Channels}" IsEnabled="{Binding ControlEnabled}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FanChannelViewModel}">
                                <Border Background="#1C2124" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentText}" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </DockPanel>
                                        <WrapPanel Margin="0,8,0,0">
                                            <!-- Modus -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                                <RadioButton Style="{StaticResource Chip}" Content="BIOS" IsChecked="{Binding IsBios}" />
                                                <RadioButton Style="{StaticResource Chip}" Content="Fest" IsChecked="{Binding IsFixed}" />
                                                <RadioButton Style="{StaticResource Chip}" Content="Kurve" IsChecked="{Binding IsCurve}" />
                                            </StackPanel>
                                            <!-- feste Leistung -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,6"
                                                        Visibility="{Binding IsFixed, Converter={StaticResource BoolToVisibility}}">
                                                <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding LessCommand}" />
                                                <TextBlock Text="{Binding FixedText}" Width="56" TextAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding MoreCommand}" />
                                            </StackPanel>
                                            <!-- Kurve: Profil + Bezugstemperatur -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0"
                                                        Visibility="{Binding IsCurve, Converter={StaticResource BoolToVisibility}}">
                                                <RadioButton Style="{StaticResource Chip}" Content="Leise" IsChecked="{Binding IsQuiet}" />
                                                <RadioButton Style="{StaticResource Chip}" Content="Ausgewogen" IsChecked="{Binding IsBalanced}" />
                                                <RadioButton Style="{StaticResource Chip}" Content="Leistung" IsChecked="{Binding IsPerformance}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsCurve, Converter={StaticResource BoolToVisibility}}">
                                                <RadioButton Style="{StaticResource Chip}" Content="nach CPU-Temp" IsChecked="{Binding IsSourceCpu}" />
                                                <RadioButton Style="{StaticResource Chip}" Content="nach CPU oder GPU (höherer Wert)" IsChecked="{Binding IsSourceMax}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding CurveText}" Style="{StaticResource SmallText}" Margin="0,2,0,0"
                                                   Visibility="{Binding IsCurve, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="NeonMonitor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NeonMonitor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="1100" d:DesignHeight="900">

    <UserControl.Resources>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="44,0,0,14" />
        </Style>
        <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="190" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="StepValue" TargetType="TextBlock">
            <Setter Property="Width" Value="110" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- ============ Design ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Design" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Themes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ThemeChoiceViewModel}">
                                    <Button Command="{Binding SelectCommand}" Margin="0,0,0,8" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{StaticResource InnerBrush}" CornerRadius="{StaticResource SmallCornerRadius}"
                                                        BorderThickness="2" BorderBrush="Transparent" Padding="10,8">
                                                    <DockPanel>
                                                        <!-- Mini-Vorschau: Hintergrund, Karte, Akzent, zweite Farbe -->
                                                        <Border DockPanel.Dock="Left" Width="74" Height="44" CornerRadius="6" Background="{Binding Background}" Margin="0,0,12,0">
                                                            <Border Margin="8,7" CornerRadius="4" Background="{Binding Panel}">
                                                                <StackPanel VerticalAlignment="Center" Margin="6,0">
                                                                    <Border Height="4" CornerRadius="2" Background="{Binding Accent}" Margin="0,0,10,4" />
                                                                    <Border Height="4" CornerRadius="2" Background="{Binding Secondary}" Margin="0,0,22,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="{StaticResource TextBrush}" />
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SmallText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ButtonHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Hintergrund-Effekt: mit jedem Design kombinierbar, wirkt sofort -->
                        <TextBlock Text="Hintergrund" Style="{StaticResource SectionLabel}" FontSize="13" Margin="0,8,0,6" />
                        <ItemsControl ItemsSource="{Binding Effects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EffectChoiceViewModel}">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="BackgroundEffect" Content="{Binding Name}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource SmallText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="Wirkt sofort und passt sich der Farbe des Designs an. Ist das Fenster minimiert, pausiert die Animation; ganz aus über den Schalter „Animation“ unten rechts." />
                        <DockPanel Visibility="{Binding ThemeChangePending, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Jetzt neu starten" Command="{Binding RestartCommand}" Padding="14,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="Das neue Design wird nach einem Neustart von NeonMonitor übernommen (dauert ein paar Sekunden)."
                                       Style="{StaticResource SmallText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Start & Infobereich ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Start &amp; Infobereich" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Option}" Content="Mit Windows starten" IsChecked="{Binding Autostart}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Startet bei der Anmeldung unsichtbar im Infobereich – über die Windows-Aufgabenplanung, daher ohne Admin-Abfrage." />
                        <CheckBox Style="{StaticResource Option}" Content="Schließen (✕) versteckt nur das Fenster" IsChecked="{Binding CloseToTray}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="NeonMonitor läuft im Infobereich weiter (Symbol unten rechts). Beenden über Rechtsklick → Beenden." />
                        <CheckBox Style="{StaticResource Option}" Content="Minimieren in den Infobereich" IsChecked="{Binding MinimizeToTray}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Statt in der Taskleiste zu bleiben." />
                    </StackPanel>
                </Border>

                <!-- ============ Handy-Ansicht ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Handy-Ansicht" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Option}" Content="Werte im Heimnetz auf Handy/Tablet anzeigen" IsChecked="{Binding Web.Enabled}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Einfach im Browser, keine App nötig. Nur lesend, nur im Heimnetz und nur mit dem Schlüssel in der Adresse. Handy muss im selben WLAN sein; das Netzwerk in Windows sollte als „Privat“ eingestellt sein." />
                        <StackPanel Visibility="{Binding Web.Enabled, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Image DockPanel.Dock="Left" Source="{Binding Web.QrCode}" Width="150" Height="150" Margin="0,0,16,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBox Text="{Binding Web.UrlsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource FlatButton}" Content="Adresse kopieren" Margin="0,0,8,8" Command="{Binding Web.CopyCommand}" />
                                        <Button Style="{StaticResource FlatButton}" Content="Am PC öffnen" Margin="0,0,8,8" Command="{Binding Web.OpenCommand}" />
                                        <Button Style="{StaticResource FlatButton}" Content="Neuer Schlüssel" Margin="0,0,8,8" Command="{Binding Web.NewKeyCommand}"
                                                ToolTip="Alte Adresse/QR-Code werden ungültig" />
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Web.Status}" Style="{StaticResource SmallText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ============ Aufnahme ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Aufnahme" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Option}" Content="Automatisch aufnehmen, wenn ein Spiel läuft" IsChecked="{Binding AutoRecord}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Startet 10 Sekunden nach Spielbeginn (flüssige FPS und GPU-Last), stoppt 15 Sekunden nach Spielende. Manuell gestoppt? Dann erst beim nächsten Spielstart wieder." />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="Benchmark-Dauer" Style="{StaticResource RowLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Chip}" Content="30 s" IsChecked="{Binding Bench30}" />
                                <RadioButton Style="{StaticResource Chip}" Content="60 s" IsChecked="{Binding Bench60}" />
                                <RadioButton Style="{StaticResource Chip}" Content="2 min" IsChecked="{Binding Bench120}" />
                                <RadioButton Style="{StaticResource Chip}" Content="5 min" IsChecked="{Binding Bench300}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                   Text="Benchmark = Aufnahme mit fester Dauer (Strg + Alt + B) – für faire Vergleiche zwischen Grafikeinstellungen." />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Strompreis" Style="{StaticResource RowLabel}" />
                            <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding PriceDown}" />
                            <TextBlock Text="{Binding PriceText}" Style="{StaticResource StepValue}" />
                            <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding PriceUp}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Für die Kosten pro Sitzung. Gerechnet wird nur CPU-Package + Grafikkarte – der ganze PC braucht etwas mehr (Mainboard, RAM, Lüfter, Netzteil-Verluste)." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <!-- ============ Warnungen ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Warnungen" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Option}" Content="Windows-Benachrichtigung bei hohen Temperaturen" IsChecked="{Binding AlertsEnabled}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Höchstens alle 5 Minuten pro Wert. Zusätzlich: Warnung, wenn der CPU-Lüfter steht, obwohl die CPU warm ist." />
                        <StackPanel IsEnabled="{Binding AlertsEnabled}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="CPU ab" Style="{StaticResource RowLabel}" />
                                <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding CpuDown}" />
                                <TextBlock Text="{Binding AlertCpuText}" Style="{StaticResource StepValue}" />
                                <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding CpuUp}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="GPU ab" Style="{StaticResource RowLabel}" />
                                <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding GpuDown}" />
                                <TextBlock Text="{Binding AlertGpuText}" Style="{StaticResource StepValue}" />
                                <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding GpuUp}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GPU-Hotspot ab" Style="{StaticResource RowLabel}" />
                                <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding HotDown}" />
                                <TextBlock Text="{Binding AlertHotText}" Style="{StaticResource StepValue}" />
                                <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding HotUp}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Updates ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Option}" Content="Automatisch nach neuen Versionen suchen" IsChecked="{Binding Update.CheckForUpdates}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Prüft beim Start und alle 6 Stunden die Releases auf GitHub. Installiert wird nur auf Knopfdruck – mit Prüfsummen-Kontrolle." />
                        <TextBlock Text="{Binding Update.CurrentVersionText}" Style="{StaticResource SmallText}" FontSize="12" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Content="Jetzt prüfen" Margin="0,0,8,0" Command="{Binding Update.CheckCommand}" />
                            <Button Style="{StaticResource FlatButton}" Content="Installieren" Margin="0,0,8,0" Command="{Binding Update.InstallCommand}" />
                            <Button Style="{StaticResource FlatButton}" Content="Releases auf GitHub" Command="{Binding Update.OpenReleasesCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Update.Status}" Style="{StaticResource SmallText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ============ Tastenkürzel & Info ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Tastenkürzel" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="13" LineHeight="22">
                            <Run Text="Strg + Alt + O" FontWeight="SemiBold" /><Run Text="   Overlay ein/aus" /><LineBreak />
                            <Run Text="Strg + Alt + R" FontWeight="SemiBold" /><Run Text="   Aufnahme starten/stoppen" /><LineBreak />
                            <Run Text="Strg + Alt + B" FontWeight="SemiBold" /><Run Text="   Benchmark starten" />
                        </TextBlock>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource SmallText}" Margin="0,16,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Content="Dokumente\NeonMonitor" Margin="0,0,8,0" Command="{Binding OpenDocumentsCommand}" />
                            <Button Style="{StaticResource FlatButton}" Content="Einstellungen &amp; Log" Command="{Binding OpenAppDataCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="NeonMonitor.Views.FpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:NeonMonitor.Controls"
             xmlns:vm="clr-namespace:NeonMonitor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FpsViewModel}"
             d:DesignWidth="1100" d:DesignHeight="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ============ Kennzahlen ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="FPS &amp; Frametimes" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding Application}" Style="{StaticResource SmallText}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,2,0,8" />
                    <UniformGrid Columns="4">
                        <ContentControl Content="{Binding Fps}" ContentTemplate="{StaticResource StatBlock}" />
                        <ContentControl Content="{Binding Low1}" ContentTemplate="{StaticResource StatBlock}" />
                        <ContentControl Content="{Binding FrameTime}" ContentTemplate="{StaticResource StatBlock}" />
                        <ContentControl Content="{Binding FrameTimeMax}" ContentTemplate="{StaticResource StatBlock}" />
                    </UniformGrid>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ Engpass | Latenz ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Engpass" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding BottleneckShort}" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,10,0,2" />
                        <TextBlock Text="{Binding BottleneckText}" Style="{StaticResource SmallText}" FontSize="13"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{Binding BottleneckTip}" Foreground="{StaticResource TextBrush}" FontSize="12"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource SmallText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                                   Text="Regel: GPU ≥ 94 % = GPU-Limit · sonst ein CPU-Thread ≥ 85 % = CPU-Limit · beides darunter = FPS-Grenze/V-Sync/Engine." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Latenz" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,2,0,8" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Zeit von deiner Eingabe bis das Bild auf dem Monitor ist (Mittel der letzten 5 s). Ohne Maus-/Monitor-Elektronik." />
                        <ContentControl Content="{Binding InputLatency}" />
                        <ContentControl Content="{Binding ClickLatency}" />
                        <ContentControl Content="{Binding DisplayDelay}" />
                        <controls:LineChart Height="70" Maximum="40" Unit="ms" Margin="0,6,0,0"
                                            Series="{Binding InputLatency.History}" Stroke="{StaticResource AccentBrush}"
                                            Series2="{Binding ClickLatency.History}" Stroke2="{StaticResource SecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Ruckler | Verbindung ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ruckler &amp; Gleichmäßigkeit" Style="{StaticResource CardTitle}" />
                        <ContentControl Content="{Binding Stutters}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource SmallText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="Ruckler = ein Bild dauert mind. doppelt so lange wie üblich (und ≥ 8 ms länger). Darunter: Verteilung der Bilddauer der letzten 30 s – ein hoher, schmaler Balken = gleichmäßig." />
                        <controls:HistogramChart Height="150" Values="{Binding Histogram}" Fill="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionText}" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                            <TextBlock Text="Verbindung &amp; Paketverlust" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" />
                        </DockPanel>
                        <ContentControl Content="{Binding LossRouter}" Margin="0,8,0,0" />
                        <ContentControl Content="{Binding LossInternet}" />
                        <ContentControl Content="{Binding PingRouter}" />
                        <ContentControl Content="{Binding PingInternet}" />
                        <ContentControl Content="{Binding Jitter}" />
                        <TextBlock Text="{Binding ConnectionVerdict}" Foreground="{StaticResource TextBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Jede Sekunde ein Ping zum Router und ins Internet (1.1.1.1), ausgewertet über die letzte Minute. Den Ping zum CoD-Server kennt nur das Spiel – diese Messung zeigt, ob der Verlust bei dir zu Hause oder beim Anbieter entsteht." />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ FPS-Verlauf ============ -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FPS-Verlauf" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="letzte 2 Minuten · grün = FPS, grau = 1 % Low" Style="{StaticResource SmallText}"
                                   HorizontalAlignment="Center" Margin="0,2,0,8" />
                        <controls:LineChart Height="180" Maximum="144"
                                            Series="{Binding Fps.History}" Stroke="{StaticResource AccentBrush}"
                                            Series2="{Binding Low1.History}" Stroke2="{StaticResource SecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ============ Frametimes ============ -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Frametimes" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="letzte 300 Bilder · Spitzen nach oben = Ruckler" Style="{StaticResource SmallText}"
                                   HorizontalAlignment="Center" Margin="0,2,0,8" />
                        <controls:LineChart Height="180" Maximum="33" Unit="ms"
                                            Series="{Binding FrameTimes}" Stroke="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Anwendung wählen ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Welche Anwendung messen?" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SmallText}" FontSize="12" Margin="0,4,0,10"
                               Text="„Automatisch“ nimmt das Spiel im Vordergrund und bleibt dabei, auch wenn du auf einem anderen Monitor klickst. Hier stehen alle Programme, die gerade Bilder ausgeben – ein Klick legt die Messung fest." />
                    <ItemsControl ItemsSource="{Binding Choices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="✕ neben einem Programm = „ist kein Spiel“ (wird dann bei FPS, automatischer Aufnahme und Spielzeit ignoriert)."
                               Style="{StaticResource SmallText}" Margin="0,2,0,0" />
                    <StackPanel Visibility="{Binding HasIgnored, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                        <TextBlock Text="Ausgeschlossen (Klick = wieder zulassen)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Ignored}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FlatButton}" Margin="0,0,8,8" Padding="12,5" Opacity="0.7"
                                            Content="{Binding}" ToolTip="Wieder als mögliches Spiel zulassen"
                                            Command="{Binding DataContext.UnignoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Anti-Cheat ============ -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                              Content="Sicherer Modus" IsChecked="{Binding SafeMode}" Margin="16,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="Anti-Cheat" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SmallText}" FontSize="12" Margin="0,4,0,0"
                                   Text="Die FPS-Messung greift nicht ins Spiel ein. Für CPU-Temperatur und -Leistung nutzt NeonMonitor aber den signierten Treiber PawnIO. Falls ein Spiel (z. B. Call of Duty mit Ricochet) deswegen meckert oder nicht startet: Sicheren Modus einschalten und NeonMonitor neu starten – dann ohne Treiber, CPU-Temperatur/-Leistung fehlen." />
                        <TextBlock Text="{Binding SafeModeHint}" Style="{StaticResource SmallText}" Margin="0,4,0,0"
                                   Foreground="{StaticResource WarnBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

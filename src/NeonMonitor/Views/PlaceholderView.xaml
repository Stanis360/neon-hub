<UserControl x:Class="NeonMonitor.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Platzhalter für Funktionen, die in späteren Schritten gebaut werden -->
    <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,30" MaxWidth="560">
        <StackPanel>
            <TextBlock Text="{Binding Step, ElementName=Root}" Style="{StaticResource SmallText}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource CardTitle}" FontSize="26"
                       HorizontalAlignment="Center" Margin="0,6,0,12" />
            <TextBlock Text="{Binding Description, ElementName=Root}" Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" FontSize="14" />
        </StackPanel>
    </Border>
</UserControl>

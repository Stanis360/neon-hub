<UserControl x:Class="NeonMonitor.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:NeonMonitor.Controls"
             xmlns:vm="clr-namespace:NeonMonitor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignWidth="1100" d:DesignHeight="900">

    <UserControl.Resources>
        <!-- Legende für Diagramme: farbiger Strich + Text -->
        <Style x:Key="LegendText" TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
            <Setter Property="Margin" Value="6,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendLine" TargetType="Rectangle">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="3" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Ring: Größe für CPU und GPU gleich -->
        <Style x:Key="Ring" TargetType="controls:RingGauge">
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="190" />
            <Setter Property="Thickness" Value="16" />
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
            <Setter Property="Stroke2" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="TrackBrush" Value="{StaticResource TrackBrush}" />
        </Style>
        <!-- Trennlinie zwischen Bereichen einer Karte -->
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource DividerBrush}" />
            <Setter Property="Margin" Value="0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ============ Hinweisbanner (fehlende Rechte/Treiber) ============ -->
            <Border Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}"
                    Background="#2AE8B44C" CornerRadius="10" Padding="14,10" Margin="6">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{StaticResource WarnBrush}" Margin="0,1,12,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" />
                </DockPanel>
            </Border>

            <!-- ============ Obere Reihe: CPU | GPU ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ CPU ============ -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource CardTitle}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Ring: außen Last, innen Temperatur -->
                            <Grid VerticalAlignment="Top">
                                <controls:RingGauge Style="{StaticResource Ring}"
                                                    Value="{Binding CpuLoad.BarValue}" Maximum="100"
                                                    Value2="{Binding CpuTemp.BarValue}" Maximum2="100" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CpuLoad.DisplayValue}" Style="{StaticResource BigValue}" />
                                        <TextBlock Text="%" Style="{StaticResource SmallText}" Margin="3,0,0,8" VerticalAlignment="Bottom" FontSize="14" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CpuTemp.DisplayWithUnit}" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                                               Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    <TextBlock Text="Last" Style="{StaticResource SmallText}" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="·" Style="{StaticResource SmallText}" Margin="5,0" />
                                    <TextBlock Text="Temp" Style="{StaticResource SmallText}" Foreground="{StaticResource SecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Rechte Spalte: Werte als Balken, darunter die einzelnen Kerne -->
                            <StackPanel Grid.Column="2">
                                <ContentControl Content="{Binding CpuTemp}" />
                                <ContentControl Content="{Binding CpuPower}" />
                                <ContentControl Content="{Binding CpuClock}" />
                                <ContentControl Content="{Binding CpuClockMax}" />
                                <TextBlock Text="Kerntakte" Style="{StaticResource SectionLabel}" Margin="0,8,0,4" />
                                <ItemsControl ItemsSource="{Binding CoreClocks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Rectangle Style="{StaticResource LegendLine}" Fill="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding CpuLoad.DisplayWithUnit, StringFormat='Last {0}'}" Style="{StaticResource LegendText}" />
                            <Rectangle Style="{StaticResource LegendLine}" Fill="{StaticResource SecondaryBrush}" />
                            <TextBlock Text="{Binding CpuTemp.DisplayWithUnit, StringFormat='Temperatur {0}'}" Style="{StaticResource LegendText}" />
                            <TextBlock Text="· letzte 2 Minuten" Style="{StaticResource LegendText}" />
                        </StackPanel>
                        <controls:LineChart Height="110" Maximum="100"
                                            Series="{Binding CpuLoad.History}" Stroke="{StaticResource AccentBrush}"
                                            Series2="{Binding CpuTemp.History}" Stroke2="{StaticResource SecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- ============ GPU ============ -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource CardTitle}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Top">
                                <Grid>
                                    <controls:RingGauge Style="{StaticResource Ring}"
                                                        Value="{Binding GpuLoad.BarValue}" Maximum="100"
                                                        Value2="{Binding GpuTemp.BarValue}" Maximum2="100" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding GpuLoad.DisplayValue}" Style="{StaticResource BigValue}" />
                                            <TextBlock Text="%" Style="{StaticResource SmallText}" Margin="3,0,0,8" VerticalAlignment="Bottom" FontSize="14" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding GpuTemp.DisplayWithUnit}" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                                                   Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <TextBlock Text="Last" Style="{StaticResource SmallText}" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="·" Style="{StaticResource SmallText}" Margin="5,0" />
                                        <TextBlock Text="Temp" Style="{StaticResource SmallText}" Foreground="{StaticResource SecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Fps.Summary}" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding GpuFanText}" Style="{StaticResource SmallText}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <ContentControl Content="{Binding GpuTemp}" />
                                <ContentControl Content="{Binding GpuHotspot}" />
                                <ContentControl Content="{Binding GpuPower}" />
                                <ContentControl Content="{Binding GpuClock}" />
                                <ContentControl Content="{Binding GpuMemClock}" />
                                <ContentControl Content="{Binding GpuVram}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Rectangle Style="{StaticResource LegendLine}" Fill="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding GpuLoad.DisplayWithUnit, StringFormat='Last {0}'}" Style="{StaticResource LegendText}" />
                            <Rectangle Style="{StaticResource LegendLine}" Fill="{StaticResource SecondaryBrush}" />
                            <TextBlock Text="{Binding GpuTemp.DisplayWithUnit, StringFormat='Temperatur {0}'}" Style="{StaticResource LegendText}" />
                            <TextBlock Text="· letzte 2 Minuten" Style="{StaticResource LegendText}" />
                        </StackPanel>
                        <controls:LineChart Height="110" Maximum="100"
                                            Series="{Binding GpuLoad.History}" Stroke="{StaticResource AccentBrush}"
                                            Series2="{Binding GpuTemp.History}" Stroke2="{StaticResource SecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Untere Reihe: Leistung | RAM | Laufwerke ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!-- Leistungsaufnahme CPU + GPU -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Leistungsaufnahme" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8">
                            <Rectangle Style="{StaticResource LegendLine}" Fill="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding GpuPower.DisplayWithUnit, StringFormat='GPU {0}'}" Style="{StaticResource LegendText}" />
                            <Rectangle Style="{StaticResource LegendLine}" Fill="{StaticResource SecondaryBrush}" />
                            <TextBlock Text="{Binding CpuPower.DisplayWithUnit, StringFormat='CPU {0}'}" Style="{StaticResource LegendText}" />
                        </StackPanel>
                        <controls:LineChart Height="150" Maximum="150" Unit="W"
                                            Series="{Binding GpuPower.History}" Stroke="{StaticResource AccentBrush}"
                                            Series2="{Binding CpuPower.History}" Stroke2="{StaticResource SecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Arbeitsspeicher -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Arbeitsspeicher" Style="{StaticResource CardTitle}" />
                        <controls:LineChart Height="90" Maximum="100" Unit="%" Margin="0,12,0,6"
                                            Series="{Binding RamLoad.History}" Stroke="{StaticResource AccentBrush}" />
                        <ContentControl Content="{Binding RamLoad}" />
                        <ContentControl Content="{Binding RamUsed}" />
                        <TextBlock Text="{Binding RamTotalText}" Style="{StaticResource SmallText}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>

                <!-- Laufwerke -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Laufwerke" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Drives}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="NeonMonitor.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NeonMonitor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OverlayViewModel}"
             d:DesignWidth="1100" d:DesignHeight="800">

    <UserControl.Resources>
        <!-- Kleiner Eckknopf in der Monitor-Skizze -->
        <Style x:Key="CornerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ============ Ein/Aus und Darstellung ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Overlay" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource SmallText}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,12"
                               Text="Kleines Fenster, das immer im Vordergrund bleibt – ideal auf einem Nebenmonitor neben dem Spiel." />
                    <WrapPanel HorizontalAlignment="Center">
                        <CheckBox Style="{StaticResource Switch}" Content="Overlay anzeigen   (Strg + Alt + O)"
                                  IsChecked="{Binding IsVisible}" Margin="0,0,32,10" VerticalAlignment="Center" />
                        <CheckBox Style="{StaticResource Switch}" Content="Fixieren (Klicks gehen hindurch)"
                                  IsChecked="{Binding ClickThrough}" Margin="0,0,32,10" VerticalAlignment="Center"
                                  ToolTip="Fixiert: nicht mehr verschiebbar, Mausklicks gehen an das Fenster darunter." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,10" VerticalAlignment="Center">
                            <TextBlock Text="Größe" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding SmallerCommand}" />
                            <TextBlock Text="{Binding ScaleText}" Width="52" TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" />
                            <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding BiggerCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="Hintergrund" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding LessOpaqueCommand}" />
                            <TextBlock Text="{Binding OpacityText}" Width="52" TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" />
                            <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding MoreOpaqueCommand}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ============ Position ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Monitore neu einlesen"
                                Command="{Binding RefreshMonitorsCommand}" />
                        <TextBlock Text="Position" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource SmallText}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"
                               Text="Klick auf eine Ecke setzt das Overlay dorthin. Alternativ das Overlay einfach mit der Maus verschieben (nicht im fixierten Modus) – die Position wird gespeichert." />
                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonitorChoice}">
                                <StackPanel Margin="0,0,24,8">
                                    <!-- Skizze eines Bildschirms mit vier Eckknöpfen -->
                                    <Border Width="200" Height="118" CornerRadius="6" Background="{StaticResource InnerBrush}"
                                            BorderBrush="{StaticResource TrackBrush}" BorderThickness="2">
                                        <Grid>
                                            <Button Style="{StaticResource CornerButton}" Content="◤" ToolTip="oben links"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding PlaceTopLeft}" />
                                            <Button Style="{StaticResource CornerButton}" Content="◥" ToolTip="oben rechts"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding PlaceTopRight}" />
                                            <Button Style="{StaticResource CornerButton}" Content="◣" ToolTip="unten links"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Command="{Binding PlaceBottomLeft}" />
                                            <Button Style="{StaticResource CornerButton}" Content="◢" ToolTip="unten rechts"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding PlaceBottomRight}" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Monitor.Index}" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Monitor.Title}" Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" FontFamily="{StaticResource DisplayFont}" />
                                    <TextBlock Text="{Binding Monitor.Resolution}" Style="{StaticResource SmallText}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ Angezeigte Werte ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Angezeigte Werte" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" />
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OverlayGroup}">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OverlayItemViewModel}">
                                                <CheckBox Style="{StaticResource Switch}" Content="{Binding Label}"
                                                          IsChecked="{Binding IsEnabled}" Margin="0,0,0,10" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

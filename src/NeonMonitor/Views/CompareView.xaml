<UserControl x:Class="NeonMonitor.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:NeonMonitor.Controls"
             xmlns:vm="clr-namespace:NeonMonitor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CompareViewModel}"
             d:DesignWidth="1100" d:DesignHeight="900">

    <UserControl.Resources>
        <!-- feste Spaltenbreite der Vergleichstabelle -->
        <GridLength x:Key="LabelWidth">150</GridLength>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sitzungsliste ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Liste neu laden" Command="{Binding RefreshCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Ordner öffnen" Command="{Binding OpenFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="Sitzungen" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="Noch keine Aufzeichnungen – im Reiter „Aufzeichnung“ starten (Strg + Alt + R)."
                           Style="{StaticResource SmallText}" FontSize="12" TextWrapping="Wrap"
                           Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
                                <Border x:Name="Row" CornerRadius="8" Padding="10,8" Margin="0,0,6,6" Background="{StaticResource InnerBrush}">
                                    <DockPanel>
                                        <!-- Farbmarke = Farbe im Vergleich -->
                                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,0,10,0" Background="{Binding ColorBrush}" />
                                        <CheckBox DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="In den Vergleich aufnehmen" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="CSV öffnen" Command="{Binding OpenCommand}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Löschen" Command="{Binding DeleteCommand}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBox Text="{Binding Game}" Padding="4,2" Background="Transparent" BorderBrush="Transparent"
                                                     ToolTip="Spielname – klicken zum Ändern" />
                                            <TextBlock Style="{StaticResource SmallText}" Margin="5,2,0,0">
                                                <Run Text="{Binding DateText, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding DurationText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding FpsText}" Style="{StaticResource SmallText}" Margin="5,1,0,0"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ Vergleich ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- ReportPanel wird für „Als Bild“ komplett gerendert -->
            <StackPanel x:Name="ReportPanel">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- Export-Knöpfe (werden beim Rendern ausgeblendet) -->
                        <StackPanel x:Name="ExportButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,-24"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource FlatButton}" Content="Als Bild speichern" Margin="0,0,6,0" Click="OnSaveImage"
                                    ToolTip="Tabelle und Diagramm als PNG in Dokumente\NeonMonitor\Berichte" />
                            <Button Style="{StaticResource FlatButton}" Content="Bild kopieren" Click="OnCopyImage"
                                    ToolTip="In die Zwischenablage – z. B. direkt in Discord einfügen (Strg+V)" />
                        </StackPanel>
                        <TextBlock Text="Vergleich" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding HardwareText}" Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SelectionHint}" Style="{StaticResource SmallText}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,2,0,12" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <!-- Kopfzeile: eine Spalte je Sitzung -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Width="150" />
                                    <ItemsControl ItemsSource="{Binding Columns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CompareColumn}">
                                                <StackPanel Width="150" Margin="0,0,10,0">
                                                    <Border Height="3" CornerRadius="1" Background="{Binding Color}" Margin="0,0,0,5" />
                                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SmallText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Zeilen: Kennzahl + Werte mit Balken -->
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CompareRow}">
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="{Binding Label}" Width="150" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="{StaticResource TextDimBrush}" />
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CompareCell}">
                                                            <StackPanel Width="150" Margin="0,0,10,0">
                                                                <TextBlock x:Name="Text" Text="{Binding Text}" FontFamily="{StaticResource DisplayFont}"
                                                                           FontSize="14" Foreground="{StaticResource TextBrush}" />
                                                                <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Height="4" Margin="0,3,0,0"
                                                                             Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                                             Foreground="{StaticResource TrackBrush}" Background="Transparent" />
                                                            </StackPanel>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                    <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                                                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ============ Verlaufsdiagramm ============ -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Metrics}" HorizontalAlignment="Center" Margin="0,10,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChartMetricChoice}">
                                    <Button x:Name="Btn" Style="{StaticResource FlatButton}" Margin="0,0,6,6" Padding="12,5"
                                            Content="{Binding Title}" Command="{Binding SelectCommand}" CommandParameter="{Binding Column}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Btn" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Btn" Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <controls:MultiLineChart Height="260" Lines="{Binding ChartLines}" Unit="{Binding ChartUnit}" />
                        <TextBlock Text="X-Achse: Zeit seit Aufnahmestart · Farben wie in der Tabelle" Style="{StaticResource SmallText}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

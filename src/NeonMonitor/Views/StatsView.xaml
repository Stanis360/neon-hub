<UserControl x:Class="NeonMonitor.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NeonMonitor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StatsViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Content="Aktualisieren" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
                            <Button Style="{StaticResource FlatButton}" Content="Zurücksetzen" Command="{Binding ResetCommand}" />
                        </StackPanel>
                        <TextBlock Text="Spielzeit" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Text="{Binding TotalText}" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                               Foreground="{StaticResource TextBrush}" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding SessionsText}" Style="{StaticResource SmallText}" FontSize="12" Margin="0,0,0,14" />
                    <TextBlock Text="Wird automatisch gezählt, sobald NeonMonitor läuft und ein Spiel FPS liefert – auch ohne Aufnahme."
                               Style="{StaticResource SmallText}" FontSize="12" Margin="0,0,0,12"
                               Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlaytimeRow}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Game}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource SmallText}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Height="8" VerticalAlignment="Center"
                                                 Margin="12,0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding FpsText}" Style="{StaticResource SmallText}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
